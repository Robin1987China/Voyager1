FROM eclipse-temurin:17-jre

ARG VOYAGER1_VERSION=0.0.2

# 基础依赖：git（构建/仓库功能）、curl（健康检查）
RUN apt-get update \
    && apt-get install -y --no-install-recommends git curl \
    && rm -rf /var/lib/apt/lists/*

ENV VOYAGER1_HOME /usr/local/voyager1-server
ENV VOYAGER1_DATA_PATH ${VOYAGER1_HOME}/data
ENV VOYAGER1_LOG_PATH ${VOYAGER1_HOME}/logs
ENV voyager1.path ${VOYAGER1_DATA_PATH}

WORKDIR ${VOYAGER1_HOME}

# 复制本地已打包的 release 产物（bin / conf / lib / LICENSE）
COPY modules/server/target/server-${VOYAGER1_VERSION}-release/bin/ ${VOYAGER1_HOME}/bin/
COPY modules/server/target/server-${VOYAGER1_VERSION}-release/conf/ ${VOYAGER1_HOME}/conf/
COPY modules/server/target/server-${VOYAGER1_VERSION}-release/lib/ ${VOYAGER1_HOME}/lib/
COPY LICENSE ${VOYAGER1_HOME}/LICENSE

# 清理本地运行时残留（pid 文件等）
RUN rm -f ${VOYAGER1_HOME}/bin/server.pid

# 将 conf 暂存为 conf_default，避免与挂载的 conf 卷冲突
RUN mv ${VOYAGER1_HOME}/conf ${VOYAGER1_HOME}/conf_default

# 时区
ENV TZ Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# 数据/日志目录（通过 volume 挂载）
RUN mkdir -p ${VOYAGER1_DATA_PATH} ${VOYAGER1_LOG_PATH}
VOLUME ${VOYAGER1_DATA_PATH} ${VOYAGER1_LOG_PATH}

EXPOSE 2122

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl -X POST -f http://localhost:2122/check-system || exit 1

ENTRYPOINT ["/bin/bash", "./bin/BlockListener.sh"]
